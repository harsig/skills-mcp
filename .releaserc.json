{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/exec", { "prepareCmd": ".github/scripts/build-release.sh v${nextRelease.version}" }],
    ["@semantic-release/github", { "assets": [{ "path": "dist/*" }] }]
  ]
}
